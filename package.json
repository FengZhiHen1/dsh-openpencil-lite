{
  "name": "dsh-openpencil-lite",
  "version": "0.1.0-rc.1",
  "description": "OpenPencil lite plugin for DSH — headless design (new/apply), pure-JSON editing, exact multi-frame previews, a read-only canvas, and a better-sidebar preview tab. No managed editor workbench.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "openpencil",
    "plugin",
    "design"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FengZhiHen1/dsh-openpencil-lite.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.*.md",
    "docs/images/dsh-openpencil-overview.png",
    "docs/images/dsh-openpencil-logo.png",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/run-tool.mjs tsc -p tsconfig.json && pnpm run build:client",
    "build:client": "node scripts/run-tool.mjs tsc -p tsconfig.client.json && node scripts/run-tool.mjs tsdown src/client/index.tsx --format cjs --platform browser --target es2022 --tsconfig tsconfig.client.json --deps.never-bundle react --deps.never-bundle react/jsx-runtime --deps.never-bundle react-dom --deps.never-bundle react-dom/client --deps.never-bundle @deepseek-ai/dsh-client-ui-primitives --out-dir .client-build --clean --sourcemap --logLevel warn && node scripts/build-client.mjs",
    "sync:viewer-assets": "node scripts/sync-viewer-assets.mjs",
    "test:viewer-assets": "node scripts/test-viewer-assets.mjs",
    "test:client": "pnpm run build:client && node --test tests/client.test.mjs",
    "test:host-api": "pnpm run build && node --test tests/host-service.test.mjs tests/new-tool.test.mjs tests/apply-tool.test.mjs tests/presentation-hydration.test.mjs",
    "test:mcp": "pnpm run build && node --test tests/mcp-client.test.mjs",
    "test:host": "pnpm run build && node scripts/test-host.mjs"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "autoInstallPeers": true,
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "dsh-better-sidebar": "^0.13.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.8",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.28.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
