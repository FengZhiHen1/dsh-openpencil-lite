.DS_Store
.client-build/
node_modules
.pnpm-store/

# Local credentials and environment overrides must never be committed.
.env
.env.*
!.env.example
.npmrc
*.pem
*.key

# Local build/test output. `lib/` is deliberately NOT ignored: the fork
# commits built artifacts so the web profile can consume it as a pinned
# `github:` git dependency without a prepare hook.
coverage/
*.log
*.tgz

# Local visual acceptance evidence may contain workspace or conversation data.
artifacts/
dsh-actual-*.png
